# Local dev: docker compose -f docker-compose.dev.yml up -d (or npm run db:local:init)
DATABASE_URL=postgresql://office:office@127.0.0.1:5433/office_hub
JWT_SECRET=replace-with-a-long-random-secret
SETUP_SECRET=replace-with-a-one-time-setup-secret
ADMIN_NAME=HR Admin
ADMIN_PASSWORD=replace-before-deploying

# npm run env:pull writes .env.vercel (Next and Prisma do not load that file).
# Bare `vercel env pull` overwrites .env.local with production DATABASE_URL;
# the next local boot throws instead of connecting to production Neon.
